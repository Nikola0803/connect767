{
  "ignoreCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" = \"master\" ]; then exit 0; else exit 1; fi",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "redirects": [
    { "source": "/shop/", "destination": "/shop", "permanent": true },
    { "source": "/listings/", "destination": "/listings", "permanent": true },
    { "source": "/listings/submit/", "destination": "/listings/submit", "permanent": true },
    { "source": "/match/", "destination": "/match", "permanent": true },
    { "source": "/uniforms/", "destination": "/uniforms", "permanent": true },
    { "source": "/about/", "destination": "/about", "permanent": true },
    { "source": "/blog/", "destination": "/blog", "permanent": true },
    { "source": "/help/", "destination": "/help", "permanent": true },
    { "source": "/privacy/", "destination": "/privacy", "permanent": true },
    { "source": "/terms/", "destination": "/terms", "permanent": true }
  ],
  "rewrites": [
    { "source": "/shop", "destination": "/shop/index.html" },
    { "source": "/listings", "destination": "/listings/index.html" },
    { "source": "/listings/submit", "destination": "/listings/submit/index.html" },
    { "source": "/match", "destination": "/match/index.html" },
    { "source": "/uniforms", "destination": "/uniforms/index.html" },
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/blog", "destination": "/blog/index.html" },
    { "source": "/help", "destination": "/help/index.html" },
    { "source": "/privacy", "destination": "/privacy/index.html" },
    { "source": "/terms", "destination": "/terms/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
