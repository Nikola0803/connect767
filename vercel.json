{
  "cleanUrls": true,
  "ignoreCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" = \"master\" ]; then exit 0; else exit 1; fi",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.connect767.com" }],
      "destination": "https://connect767.com/$1",
      "permanent": true
    },
    { "source": "/directory", "destination": "/listings", "permanent": true },
    { "source": "/add-listing", "destination": "/listings/submit", "permanent": true },
    { "source": "/the-shop", "destination": "/shop", "permanent": true },
    { "source": "/uniform-studio", "destination": "/uniforms", "permanent": true },
    { "source": "/shop/", "destination": "/shop", "permanent": true },
    { "source": "/listings/", "destination": "/listings", "permanent": true },
    { "source": "/listings/submit/", "destination": "/listings/submit", "permanent": true },
    { "source": "/match/", "destination": "/match", "permanent": true },
    { "source": "/uniforms/", "destination": "/uniforms", "permanent": true },
    { "source": "/about/", "destination": "/about", "permanent": true },
    { "source": "/blog/", "destination": "/blog", "permanent": true },
    { "source": "/help/", "destination": "/help", "permanent": true },
    { "source": "/privacy/", "destination": "/privacy", "permanent": true },
    { "source": "/terms/", "destination": "/terms", "permanent": true }
  ]
}
