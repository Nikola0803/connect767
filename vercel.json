{
  "cleanUrls": true,
  "ignoreCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" = \"master\" ]; then exit 0; else exit 1; fi",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(self)" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self' https://*.paypal.com; script-src 'self' 'unsafe-inline' https://js.stripe.com https://*.paypal.com https://*.paypalobjects.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https:; frame-src 'self' https://js.stripe.com https://hooks.stripe.com https://*.paypal.com; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/uploads/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/models/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/listings",
      "has": [{ "type": "query", "key": "category" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/listings",
      "has": [{ "type": "query", "key": "q" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/listings",
      "has": [{ "type": "query", "key": "tier" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/listings",
      "has": [{ "type": "query", "key": "booking" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/shop",
      "has": [{ "type": "query", "key": "category" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "wc-ajax" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.connect767.com" }],
      "destination": "https://connect767.com/$1",
      "permanent": true
    },
    {
      "source": "/wp-login.php",
      "has": [{ "type": "query", "key": "action", "value": "lostpassword" }],
      "destination": "/auth/forgot-password",
      "permanent": true
    },
    {
      "source": "/wp-login.php",
      "has": [{ "type": "query", "key": "action", "value": "register" }],
      "destination": "/auth/register",
      "permanent": true
    },
    { "source": "/wp-login.php", "destination": "/auth/login", "permanent": true },
    { "source": "/wp-:script.php", "destination": "/", "permanent": true },
    { "source": "/wp-json/", "destination": "https://admin.connect767.com/wp-json/", "permanent": true },
    { "source": "/wp-json/:path*/", "destination": "https://admin.connect767.com/wp-json/:path*/", "permanent": true },
    { "source": "/wp-json/:path*", "destination": "https://admin.connect767.com/wp-json/:path*", "permanent": true },
    { "source": "/wp-content/:path*/", "destination": "https://admin.connect767.com/wp-content/:path*/", "permanent": true },
    { "source": "/wp-content/:path*", "destination": "https://admin.connect767.com/wp-content/:path*", "permanent": true },
    { "source": "/login", "destination": "/auth/login", "permanent": true },
    { "source": "/register", "destination": "/auth/register", "permanent": true },
    { "source": "/lost-password", "destination": "/auth/forgot-password", "permanent": true },
