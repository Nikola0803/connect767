# Copy to .env.production (or .env.local for local dev) and fill in once
# the WordPress/WooCommerce companion plugin is live. Leave unset to run
# entirely on local fixture data — see WORDPRESS.md for the full
# integration plan.
#
# This is the ONLY variable needed. Shop products/categories go through a
# server-side proxy in connect767-cms (class-woocommerce.php) that reads
# WooCommerce data directly on the server — no WooCommerce REST consumer
# key/secret is ever needed in this client-side app, so there's nothing
# sensitive to accidentally ship in the built JS bundle.
#
# IMPORTANT: Vite bakes this in at build time, not read at runtime — set it
# BEFORE running `npm run build`, and rebuild after any change to it.

# Base URL of the WordPress install (no trailing slash), e.g.:
# VITE_WP_BASE_URL=https://connect767.com
VITE_WP_BASE_URL=

# Mapbox public token (pk.*), used for geocoding + static map images on
# ListingProfile.jsx. Safe to ship client-side, but kept out of tracked
# source so it isn't hardcoded in git history — see src/lib/mapbox.js.
VITE_MAPBOX_TOKEN=
